##############################################################################
# ACCOUNT CONFIGURATION
##############################################################################

# Production environment (enabled by default)
enable_gcp_prod_environment = true
prod_project_id             = "your-gcp-project-id"
gcp_region                  = "us-central1"  # Region where resources will be deployed

# Optional: For cross-account scenarios (leave commented for single-project mode)
# enable_gcp_dev_environment = true
# dev_project_id             = "your-dev-gcp-project-id"

# enable_gcp_ops_environment = true
# operations_project_id      = "your-ops-gcp-project-id"

##############################################################################
# SCENARIO ENABLEMENT
# Set to true to enable a scenario, false to disable
##############################################################################

# SINGLE-ACCOUNT PRIVESC ONE-HOP TO-ADMIN
enable_gcp_single_account_privesc_one_hop_to_admin_gcp_cloudfunctions_001_iam_serviceaccountsactas_cloudfunctions_functionscreate = false  # gcp-cloudfunctions-001: iam.serviceAccounts.actAs + cloudfunctions.functions.create escalation
enable_gcp_single_account_privesc_one_hop_to_admin_gcp_iam_001_iam_serviceaccountsgetaccesstoken = false  # gcp-iam-001: iam.serviceAccounts.getAccessToken impersonation escalation
